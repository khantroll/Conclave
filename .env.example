# Conclave reads provider definitions from a JSON config file.
# See conclave.example.json. Keep API keys in environment variables, not in the JSON.
CONCLAVE_CONFIG_PATH=conclave.json

# SQLite database used for persistent workspaces.
CONCLAVE_DB_PATH=conclave.db

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LITELLM_API_KEY=
